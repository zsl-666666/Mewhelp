# 必填：OpenAI 兼容上游
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o-mini

# 可选
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
CONTEXT_TOKEN_BUDGET=3000
STRUCTURED_OUTPUT_METHOD=function_calling
COMPANY_NAME=好物商城
SERVICE_HOURS=9:00-21:00
RETURN_WINDOW_DAYS=7

# 切换示例（择一，模型名以供应商当前文档为准）
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
# Ollama:   LLM_BASE_URL=http://127.0.0.1:11434/v1  LLM_MODEL=qwen2.5:7b
# Claude:   经 OpenAI 兼容网关（OpenRouter / LiteLLM / one-api），base_url 指向网关

# MySQL（Docker Compose）
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=customer_service
MYSQL_USER=customer_service
MYSQL_PASSWORD=change-me-app-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
